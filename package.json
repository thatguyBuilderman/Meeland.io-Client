{
  "name": "meeland-client",
  "productName": "Meeland Client",
  "version": "1.1.3",
  "description": "Meeland.io desktop client with Discord Rich Presence",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "author": "Meeland",
  "license": "MIT",
  "dependencies": {
    "discord-rpc": "^4.0.1",
    "electron-updater": "^6.8.9",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.15.3",
    "javascript-obfuscator": "^5.6.0"
  },
  "build": {
    "appId": "com.meeland.client",
    "productName": "Meeland Client",
    "artifactName": "Meeland-Client-${version}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!dist/**",
      "!node_modules/**",
      "!data/**",
      "!.github/**"
    ],
    "extraFiles": [
      {
        "from": "data",
        "to": "data",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/MeelandNew.ico"
    },
    "mac": {
      "icon": "assets/MeelandNew.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.games",
      "artifactName": "Meeland-Client-macOS-${arch}-${version}.${ext}"
    },
    "dmg": {
      "title": "Meeland Client",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "thatguyBuilderman",
        "repo": "Meeland.io-Client"
      }
    ]
  }
}
